<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2.5.1 declares its FSharp.Core dependency (the F# MSDP assembly needs it); earlier versions
         did not, which crashed MSDP negotiation. No explicit FSharp.Core reference needed anymore. -->
    <PackageReference Include="TelnetNegotiationCore" Version="4.11.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <!-- Decodes server output (ANSI/VT, MXP, Pueblo) into MarkupText and folds it into display spans. -->
    <PackageReference Include="MarkupString.Ansi" Version="2.31.0" />
    <PackageReference Include="MarkupString.Html" Version="2.31.0" />
    <PackageReference Include="MarkupString.Mxp" Version="2.31.0" />
    <PackageReference Include="MarkupString.Pueblo" Version="2.31.0" />
  </ItemGroup>

</Project>
